{
    "compilerOptions": {
        /* Language */
        "target": "ES2022",
        "module": "CommonJS",
        "lib": ["ES2022", "DOM"],

        /* Project */
        "rootDir": ".",
        "outDir": "./dist",

        /* Module Resolution */
        "moduleResolution": "Node",
        "baseUrl": ".",

        "paths": {
            "@config/*": ["config/*"],
            "@pages/*": ["pages/*"],
            "@helpers/*": ["helpers/*"],
            "@fixtures/*": ["fixtures/*"],
            "@utils/*": ["utils/*"],
            "@locators/*": ["locators/*"],
            "@tests/*": ["tests/*"],
            "@steps/*": ["step-definitions/*"],
            "@features/*": ["features/*"],
            "@crawler/*": ["crawler/*"],
            "@knowledge/*": ["knowledge/*"],
            "@prompts/*": ["prompts/*"]
        },

        /* JavaScript Support */
        "allowJs": false,

        /* Type Checking */
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "forceConsistentCasingInFileNames": true,

        /* Module Interop */
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,

        /* Source Maps */
        "sourceMap": true,

        /* Types */
        "types": [
            "node",
            "@playwright/test"
        ],

        /* Skip */
        "skipLibCheck": true
    },

    "include": [
        "**/*.ts"
    ],

    "exclude": [
        "node_modules",
        "dist",
        "playwright-report",
        "test-results"
    ]
}