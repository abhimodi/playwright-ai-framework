{
    "compilerOptions": {
        /* Language */
        "target": "ES2022",
        "module": "CommonJS",
        "lib": ["ES2022", "DOM"],

        /* Project */
        "rootDir": ".",
        "outDir": "./dist",

        /* Module Resolution */
        "moduleResolution": "node",
        "ignoreDeprecations": "6.0",
        "baseUrl": ".",

        "paths": {
            "@config/*": ["src/config/*"],
            "@pages/*": ["src/pages/*"],
            "@helpers/*": ["helpers/*"],
            "@fixtures/*": ["fixtures/*"],
            "@utils/*": ["src/shared/utils/*"],
            "@locators/*": ["locators/*"],
            "@tests/*": ["src/tests/*"],
            "@steps/*": ["step-definitions/*"],
            "@features/*": ["features/*"],
            "@crawler/*": ["crawler/*"],
            "@knowledge/*": ["knowledge/*"],
            "@prompts/*": ["prompts/*"]
        },

        /* JavaScript Support */
        "allowJs": false,

        /* Type Checking */
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "forceConsistentCasingInFileNames": true,

        /* Module Interop */
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,

        /* Source Maps */
        "sourceMap": true,

        /* Types */
        "types": ["node", "@playwright/test"],

        /* Skip */
        "skipLibCheck": true
    },

    "include": ["**/*.ts"],

    "exclude": ["node_modules", "dist", "playwright-report", "test-results"]
}
